// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"] // Ajoutez cette ligne
}

datasource db {
  provider = "postgresql" // Mettre "postgresql" ici
  url      = env("DATABASE_URL")
}

// Modèle pour les utilisateurs, gérant les deux rôles possibles
model User {
  id       String    @id @default(cuid())
  email    String    @unique
  password String
  role     Role      @default(EMPLOYEE)
  bookings Booking[]
}

// Définition des rôles possibles pour un utilisateur
enum Role {
  EMPLOYEE
  ADMIN
}

// Modèle pour les salles de réunion
model Room {
  id       String    @id @default(cuid())
  name     String    @unique
  capacity Int
  features String
  rules    Json
  bookings Booking[]
}

// Modèle pour une réservation, qui lie un User et une Room
model Booking {
  id    String   @id @default(cuid())
  start DateTime
  end   DateTime

  // Relation avec l'utilisateur qui a réservé
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Relation avec la salle qui est réservée
  roomId String
  room   Room   @relation(fields: [roomId], references: [id])
}
